{%- comment -%}
  Feedback loop drawing. Shown only once the image exists:
  assets/images/policy-feasibility/feedback-loop.png (any proportions; about 1.8 : 1 suits the column).
{%- endcomment -%}
{%- assign loop_path = '/assets/images/policy-feasibility/feedback-loop.png' -%}
{%- assign loop_img = site.static_files | where: 'relative_path', loop_path | first -%}
{%- if loop_img -%}
  <figure class="pf-loop">
    <img
      src="{{ loop_path | relative_url }}"
      alt="A loop: a decision window leads to a scenario run with prices and cost shares, which feeds the assessment of adjustment burden and coalitions, which informs the next decision window."
      loading="lazy"
      decoding="async"
    >
  </figure>
{%- endif -%}
