<section id="pf-scope" class="pf-section">
  <h2><span class="pf-section-number">02</span> Look across places and time</h2>
  <p class="pf-prose">
    The outside view uses precedents, public debate and actor commitments to identify plausible policy directions. Here, the survey follows disputes
    over new electricity demand, local benefits and who pays.
  </p>
  <div class="pf-outside-part">
    <h3>Across places</h3>
    <div class="pf-place-choices" role="group" aria-label="Geographic example" hidden>
      {% for o in pf.outside -%}
        <button type="button" data-pf-place="{{ o.code }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">
          {{ o.country }}
        </button>
      {%- endfor %}
    </div>
    <div class="pf-spatial-grid">
      <figure class="pf-place-map" hidden>
        <svg id="pf-place-map" viewBox="0 0 440 330" role="img" aria-labelledby="pf-map-title pf-map-description">
          <title id="pf-map-title">Locations in the policy survey</title><desc id="pf-map-description">Five European examples, with the United States in a separate locator. Choose a country using the buttons to read its example.</desc>
        </svg>
        <figcaption class="pf-caption">Policy examples · <a href="https://www.naturalearthdata.com/">Natural Earth</a></figcaption>
      </figure>
      <div class="pf-place-readings" aria-live="polite">
        {% for o in pf.outside %}
          <article id="pf-place-{{ o.code }}" class="pf-place-reading">
            <p class="pf-caption">{{ o.country }} · {{ o.status }}</p>
            <h4>{{ o.heading }}</h4>
            <p>{{ o.contribution }}</p>
            <p class="pf-take-forward">{{ o.limit }}</p>
            <details class="pf-citation-note">
              <summary>Sources</summary>
              {% include policy-feasibility/references.liquid ids=o.evidence %}
            </details>
          </article>
        {% endfor %}
      </div>
    </div>
  </div>
  <div class="pf-outside-part">
    <h3>Across time</h3>
    <div class="pf-history-examples">
      {% for h in pf.history %}
        <details class="pf-history-example">
          <summary>
            <strong>{{ h.technology }}</strong><span class="pf-caption">{{ h.period }}</span><span>{{ pf.history_previews[h.id] }}</span>
          </summary>
          <p>{{ h.change }}</p>
          <p>{{ h.response }}</p>
          <p class="pf-take-forward">{{ h.method_question }}</p>
          <ul class="pf-history-sources">
            {% for id in h.source_ids -%}
              {%- assign source = pf.history_sources | where: 'id', id | first %}
              <li>
                <a href="{{ '/projects/political-feasibility/evidence/' | relative_url }}#{{ id }}">{{ source.issuer }} · {{ source.date }}</a>
              </li>
            {% endfor %}
          </ul>
        </details>
      {% endfor %}
      <details class="pf-history-example">
        <summary>
          <strong>Bensinupproret · Sweden</strong><span class="pf-caption">2019</span><span>{{ pf.history_previews.bensin }}</span>
        </summary>
        <p>{{ pf.historical_mobilisation.text }}</p>
        <p class="pf-take-forward">{{ pf.historical_mobilisation.method_question }}</p>
        {% include policy-feasibility/references.liquid ids=pf.historical_mobilisation.evidence %}
      </details>
    </div>
  </div>
  <div id="pf-actors" class="pf-outside-part">
    <h3>What emerges in Sweden?</h3>
    <div class="pf-actor-findings">
      {% for finding in pf.actor_previews %}
        <article>
          <h4>{{ finding.title }}</h4>
          <p>{{ finding.text }}</p>
        </article>
      {% endfor %}
    </div>
    <details class="pf-note">
      <summary>Swedish actors, positions and sources</summary>
      <div class="pf-conflicts">
        {% for c in pf.actor_conflicts %}
          <article>
            <h4>{{ c.title }}</h4>
            <div>
              <p>{{ c.text }}</p>
              {% include policy-feasibility/references.liquid ids=c.evidence %}
            </div>
          </article>
        {% endfor %}
      </div>
      <p>
        Rule-keepers defend a policy, rule-switchers seek to change it, and rule-takers adapt without leading support or opposition. An actor’s role
        can change as costs, interests and alliances develop.
      </p>
      <div class="pf-actor-records">
        {% for a in pf.actors %}
          <details>
            <summary>{{ a.name }}</summary>
            <p>{{ a.capacity }}</p>
            <p>{{ a.position_overall }}</p>
            <p class="pf-caption">{{ a.policy_question }}</p>
            {% include policy-feasibility/references.liquid ids=a.evidence %}
          </details>
        {% endfor %}
      </div>
    </details>
    <div class="pf-outside-finding">
      <h4>Follow the conflict forward</h4>
      <p>
        AI investment and industrial electrification raise competing claims on electricity. If supply and grids fall behind, higher bills and delayed
        projects can change public priorities and organise new opposition. The comparison below explores both that development and one in which supply
        keeps pace.
      </p>
      <details class="pf-citation-note">
        <summary>Evidence for these possible developments</summary>
        {% include policy-feasibility/references.liquid ids=pf.political_development.evidence %}
      </details>
    </div>
  </div>
</section>
