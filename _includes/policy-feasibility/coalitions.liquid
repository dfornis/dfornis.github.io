{% assign policy_ids = include.pair.id | split: '-' %}
<div class="pf-coalition-grid">
  {% for policy_id in policy_ids %}
    {% assign policy = pf.trajectories | where: 'id', policy_id | first %}
    <div class="pf-coalition">
      <h4>
        <small>{{ policy.id }}</small>{{ policy.short_title }}
      </h4>
      <ul>
        {% for actor in include.development.adoption[include.pair.id].coalitions[policy_id] %}
          <li class="pf-support-{{ actor.kind }}">
            <strong>{{ actor.name }}</strong>
            <p>{{ actor.note }}</p>
            <span class="pf-sr-only">
              {% if actor.kind == 'documented' %}Documented support.{% else %}Possible alignment under this assumption.{% endif %}
            </span>
          </li>
        {% endfor %}
      </ul>
    </div>
  {% endfor %}
</div>
