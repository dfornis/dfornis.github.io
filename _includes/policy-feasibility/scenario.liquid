{% assign sc = site.data.policy_feasibility_scenarios %}
{% assign ref = sc.reference %}
{% assign c_t0 = sc.cases | where: 'id', 'T0' | first %}
{% assign c_t1 = sc.cases | where: 'id', 'T1' | first %}
{% assign c_t1b = sc.cases | where: 'id', 'T1b' | first %}
{% assign c_t2 = sc.cases | where: 'id', 'T2' | first %}
<section id="pf-model" class="pf-section pf-reveal">
  <p class="pf-step-tag">Scenario use</p>
  <h2><span class="pf-section-number">05</span> Bring the assessment into the scenario</h2>

  <p class="pf-prose">{{ pf.model_application.setting }}</p>
  <div class="pf-settings">
    <div class="pf-setting">
      <p class="pf-setting-label">Adopted-policy setting</p>
      <ul>
        {% for t in pf.trajectories %}
          {% if t.scenario_use == 'Adopted-policy baseline' or t.scenario_use == 'Sensitivity case' %}
            <li data-trajectory="{{ t.id }}">
              <span class="pf-swatch" aria-hidden="true"></span><strong>{{ t.scenario_use | remove: 'Adopted-policy ' | capitalize }}</strong>
              {{ t.id }}
              {{ t.short_title }}
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    </div>
    <div class="pf-setting">
      <p class="pf-setting-label">Exploratory setting</p>
      <ul>
        {% for t in pf.trajectories %}
          {% if t.scenario_use == 'Alternative policy future' %}
            <li data-trajectory="{{ t.id }}">
              <span class="pf-swatch" aria-hidden="true"></span><strong>Alternative future</strong> {{ t.id }}
              {{ t.short_title }}
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    </div>
  </div>

  <div class="pf-quantify">
    <h3>Quantification, {{ sc.model.result_year }}</h3>
    <p class="pf-prose">
      Each trajectory is then quantified in a Nordic electricity model for {{ sc.model.result_year }}. Without a requirement, other Swedish customers
      pay about {{ c_t0.values.other_bill }} billion euros a year more than without the new datacenters. A requirement that counts any new fossil-free
      generation changes little, about {{ c_t1.values.other_bill }} billion, since it is mostly met by wind farms that would be built anyway. A
      requirement for additional generation reduces the extra cost to about {{ c_t1b.values.other_bill }} billion and raises the datacenters’ own
      electricity cost by about a tenth. A halt to new establishments gives about the same relief, {{ c_t2.values.other_bill }} billion, as
      datacenters in Norway and Finland still raise Nordic prices.
    </p>
    {% assign m_price = sc.metrics | where: 'id', 'price_se' | first %}
    <figure class="pf-bars" aria-labelledby="pf-bars-caption">
      <figcaption id="pf-bars-caption">{{ m_price.label }}, {{ sc.model.result_year }} · {{ m_price.unit }}, weighted by consumption</figcaption>
      <div class="pf-bar-row pf-bar-reference">
        <span class="pf-bar-label">{{ ref.label }}</span>
        <span class="pf-bar-track"
          ><span class="pf-bar" style="width: {{ ref.values.price_se | times: 100.0 | divided_by: sc.price_scale_max }}%"></span
        ></span>
        <span class="pf-bar-value">{{ ref.values.price_se }}</span>
      </div>
      {% for c in sc.cases %}
        {% assign t = pf.trajectories | where: 'id', c.id | first %}
        <div class="pf-bar-row" data-trajectory="{{ c.id }}">
          <span class="pf-bar-label"
            ><small>{{ c.id }}</small>{{ t.short_title -}}
          </span>
          {% if c.values.price_se == null %}
            <span class="pf-bar-track"
              ><span class="pf-bar-pending"
                >pending{% if c.note %} · {{ c.note }}{% endif -%}
              </span></span
            >
            <span class="pf-bar-value">–</span>
          {% else %}
            <span class="pf-bar-track"
              ><span class="pf-bar" style="width: {{ c.values.price_se | times: 100.0 | divided_by: sc.price_scale_max }}%"></span
              ><span class="pf-bar-marker" style="left: {{ ref.values.price_se | times: 100.0 | divided_by: sc.price_scale_max }}%"></span
            ></span>
            <span class="pf-bar-value">{{ c.values.price_se }}</span>
          {% endif %}
        </div>
      {% endfor %}
      <p class="pf-caption">Scale 0–{{ sc.price_scale_max }} EUR/MWh. The thin line marks {{ ref.label | downcase }}.</p>
    </figure>
    <div class="pf-table-scroll">
      <table class="pf-results">
        <thead>
          <tr>
            <th scope="col">Trajectory</th>
            {% for m in sc.metrics %}
              {% unless m.id == 'price_se' %}
                <th scope="col">
                  {{ m.label }}
                  <span class="pf-unit">{{ m.unit }}</span>
                </th>
              {% endunless %}
            {% endfor %}
          </tr>
        </thead>
        <tbody>
          {% for c in sc.cases %}
            {% assign t = pf.trajectories | where: 'id', c.id | first %}
            <tr data-trajectory="{{ c.id }}">
              <th scope="row">
                <span class="pf-swatch" aria-hidden="true"></span><small>{{ c.id }}</small>{{ t.short_title }}
              </th>
              {% for m in sc.metrics %}
                {% unless m.id == 'price_se' %}
                  {% assign v = c.values[m.id] %}
                  <td data-label="{{ m.label }} · {{ m.unit }}">
                    {%- if v == null -%}
                      {%- if c.id == 'T2' and m.id == 'dc_cost' -%}
                        –
                      {%- else -%}
                        <span class="pf-pending">pending</span>
                      {%- endif -%}
                    {%- else -%}
                      {{- v | replace: '-', '−' -}}
                    {%- endif -%}
                  </td>
                {% endunless %}
              {% endfor %}
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>

  <div id="pf-additionality" class="pf-callout">
    <h3>Is new generation additional?</h3>
    <p>
      Onshore wind is built up to its permitting limit whether or not the datacenters arrive. Under T1, developers can therefore meet the requirement
      by contracting wind farms that would be built anyway. Only T1b, which counts generation the market would not build, lowers prices markedly.
      Before quantification, the specification of a trajectory therefore matters as much as its political feasibility.
    </p>
    {% assign ad = sc.additionality %}
    <figure class="pf-stack" aria-labelledby="pf-stack-caption">
      <figcaption id="pf-stack-caption">Requirement, {{ ad.required_twh }} TWh · how it is met in Sweden</figcaption>
      {% for a in ad.cases %}
        {% assign t = pf.trajectories | where: 'id', a.id | first %}
        <div class="pf-bar-row" data-trajectory="{{ a.id }}">
          <span class="pf-bar-label"
            ><small>{{ a.id }}</small>{{ t.short_title -}}
          </span>
          <span class="pf-bar-track">
            {%- if a.new_twh == null -%}
              <span class="pf-bar-pending"
                >pending{% if a.note %} · {{ a.note }}{% endif -%}
              </span>
            {%- else -%}
              <span
                class="pf-stack-part pf-stack-relabelled"
                style="width: {{ a.relabelled_twh | times: 100.0 | divided_by: ad.scale_max }}%"
              ></span
              ><span class="pf-stack-part pf-stack-new" style="width: {{ a.new_twh | times: 100.0 | divided_by: ad.scale_max }}%"></span>
            {%- endif -%}
          </span>
          <span class="pf-bar-value"></span>
          {% if a.new_twh != null %}
            <span class="pf-stack-detail">
              <span><span class="pf-key pf-stack-relabelled" aria-hidden="true"></span>~{{ a.relabelled_twh }} TWh relabelled</span>
              <span><span class="pf-key pf-stack-new" aria-hidden="true"></span>~{{ a.new_twh }} TWh new</span>
            </span>
          {% endif %}
        </div>
      {% endfor %}
      <p class="pf-caption">Relabelled: generation that would be built anyway. New: generation the market would not otherwise build in Sweden.</p>
    </figure>
    <p class="pf-caption">{{ ad.note }}</p>
  </div>

  <div class="pf-drawers">
    <details class="pf-drawer">
      <summary><strong>Matched hour by hour</strong><span>How much of datacenter use each portfolio covers in the same hour</span></summary>
      <div class="pf-drawer-body">
        <p class="pf-prose">{{ sc.coverage.text }}</p>
        <figure class="pf-bars pf-bars-thin" aria-label="Hourly coverage by portfolio">
          {% for i in sc.coverage.items %}
            <div class="pf-bar-row{% if i.highlight %} pf-bar-highlight{% endif %}">
              <span class="pf-bar-label">{{ i.label }}</span>
              <span class="pf-bar-track"><span class="pf-bar" style="width: {{ i.value }}%"></span></span>
              <span class="pf-bar-value">{{ i.value }}%</span>
            </div>
          {% endfor %}
          <p class="pf-caption">Annual output equal to annual use. Scale 0–100%.</p>
        </figure>
      </div>
    </details>
    <details class="pf-drawer">
      <summary><strong>Variants</strong><span>Half the volume, new nuclear only, a battery condition</span></summary>
      <div class="pf-drawer-body pf-table-scroll">
        <table class="pf-results">
          <thead>
            <tr>
              <th scope="col">Variant</th>
              {% for m in sc.metrics %}
                <th scope="col">
                  {{ m.label }}
                  <span class="pf-unit">{{ m.unit }}</span>
                </th>
              {% endfor %}
            </tr>
          </thead>
          <tbody>
            {% for v in sc.variants %}
              {% assign meta = pf.variants | where: 'id', v.id | first %}
              <tr>
                <th scope="row">{{ meta.title }}</th>
                {% for m in sc.metrics %}
                  <td data-label="{{ m.label }} · {{ m.unit }}">{{ v.values[m.id] | replace: '-', '−' }}</td>
                {% endfor %}
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </details>
  </div>

  <div class="pf-closing">
    <div class="pf-model-feedback">
      <p class="pf-caption">Back to the next decision window</p>
      {% include policy-feasibility/feedback-loop.liquid %}
      <p>{{ pf.model_application.feedback }}</p>
    </div>
    <div class="pf-assumptions">
      <p class="pf-caption">Model and assumptions</p>
      <p>{{ sc.model.name }}, {{ sc.model.result_year }}, weather year {{ sc.model.weather_year }}. A stylised model. {{ sc.model.setup }}</p>
      <dl>
        {% for a in sc.assumptions %}
          <div>
            <dt>{{ a.label }}</dt>
            <dd>{{ a.value }}</dd>
          </div>
        {% endfor %}
      </dl>
    </div>
  </div>
</section>
