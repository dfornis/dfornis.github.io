<span class="pf-rating pf-rating-{{ include.rating }}" aria-hidden="true">
  <svg viewBox="0 0 16 16" focusable="false">
    <circle cx="8" cy="8" r="6.2" class="pf-rating-ring" />
    {%- if include.rating == 'favourable' -%}
      <circle cx="8" cy="8" r="6.2" class="pf-rating-fill" />
    {%- elsif include.rating == 'mixed' -%}
      <path d="M8 1.8a6.2 6.2 0 0 1 0 12.4z" class="pf-rating-fill" />
    {%- endif -%}
  </svg></span
><span class="pf-sr-only">{{ include.rating | capitalize }}.</span>
